# ============================================================
# Dynamit Bygg – .env.example
# Kopiera till .env och fyll i dina uppgifter
# ============================================================

# --- Server ---
PORT=3000
HOST=localhost

# --- Företagsuppgifter (visas i HTML-placeholders och e-post) ---
COMPANY_NAME=Dynamit Bygg AB
COMPANY_PHONE=070-123 45 67
COMPANY_EMAIL=info@dynamitbygg.se
COMPANY_ADDRESS=Byggvägen 12
COMPANY_POSTAL_CODE=12345
COMPANY_CITY=Stockholm
COMPANY_ORG_NR=556123-4567
COMPANY_AREA=Stockholm och omnejd

# --- E-post (SMTP) ---
# Rekommendation: Använd Resend.com (enast) eller Gmail App Password
#
# ALTERNATIV 1: Gmail (enklast för provning)
#   1. Gå till https://myaccount.google.com/apppasswords
#   2. Skapa ett app-lösenord
#   3. Fyll i nedan
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=din-epost@gmail.com
SMTP_PASS=dit-app-losenord-här

# ALTERNATIV 2: Resend.com (rekommenderat för produktion)
#   1. Skapa konto på https://resend.com
#   2. Verifiera din domän
#   3. Använd deras SMTP eller API
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=resend
# SMTP_PASS=re_-din-nyckel-här

# ALTERNATIV 3: SendGrid
#   1. Skapa konto på https://sendgrid.com
#   2. Skapa en API-nyckel
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=SG.din-nyckel-här

# Frånadress (syns som avsändare i e-post)
EMAIL_FROM=Dynamit Bygg <info@dynamitbygg.se>

# Vart företagets notifieringar skickas
NOTIFY_EMAIL=info@dynamitbygg.se

# --- Filuppladdning ---
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads
